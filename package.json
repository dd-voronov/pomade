{
  "name": "pomade",
  "version": "0.3.3",
  "description": "Pomade — personal macOS Agentic Development Environment",
  "author": "Daniil Voronov",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w node-pty",
    "dev": "electron-vite dev",
    "start": "electron-vite build && electron-vite preview",
    "build": "electron-vite build",
    "test:unit": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.cli.json",
    "dist:mac": "electron-vite build && node scripts/bundle-apps.mjs && electron-builder --mac",
    "bundle-apps": "node scripts/bundle-apps.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:affected": "node scripts/e2e-affected.mjs",
    "smoke:scale": "electron-vite build && node scripts/smoke-scale.mjs"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@electron/rebuild": "^4.2.0",
    "@milkdown/kit": "^7.21.3",
    "@milkdown/react": "^7.21.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "emojibase-data": "^17.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-gfm": "^3.0.0",
    "nanoid": "^5.1.16",
    "pomade-kit": "github:dd-voronov/pomade-kit#v0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.27.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.21",
    "vitest": "^4.1.11",
    "zustand": "^5.0.14"
  }
}
